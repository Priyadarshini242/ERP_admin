# Copy to .env.local
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=QuickERP
NEXT_PUBLIC_APP_TAGLINE=Retail & Wholesale
NEXT_PUBLIC_COMPANY_NAME=My Company

# GST state code of the company (must match backend COMPANY_STATE_CODE)
NEXT_PUBLIC_COMPANY_STATE_CODE=33

# true = require login (JWT via the backend); false/absent = open app, no login screen
NEXT_PUBLIC_AUTH_ENABLED=false
